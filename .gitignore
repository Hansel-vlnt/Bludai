# =============================================================================
# Bludai Unified Project .gitignore
# =============================================================================

# --- Environment & Sensitive Secrets (NEVER COMMIT) ---
.env
.env.*
*.env
*.key
*.pem
*.cert

# --- Bludai Runtime Configurations & Local Settings ---
.bludai*
*.bludai*
**/.bludai*
**/*.bludai*
*.json.bak
.bludai_settings.json
.bludai_roles.json
.bludai_history

# --- Python & Virtual Environments ---
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
env/
venv/
.venv/
env.bak/
venv.bak/
*.egg-info/
build/
develop-eggs/
downloads/
eggs/
.eggs/
parts/
var/
wheels/
*.egg
.pytest_cache/
.coverage

# --- Node.js & Web Frontend ---
node_modules/
**/node_modules/
dist/
**/dist/
dist-ssr/
*.local
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Operating System & IDE Files ---
.DS_Store
Thumbs.db
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.bak

# --- Reference Directories & Local Clones ---
hermes-agent/
9router/
openclaw/
belajar/

# --- Temporary Notes & Brainstorming Docs ---
9router.md
Hermes.md
plan.md
task.md
